// Beautijoo Prisma Schema — Source of Truth
// Phase 1: placeholder. Full schema in Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so prisma generate succeeds
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
