# Copy to .env for local development. Never commit .env.
# In production set these in the host secret store (see DEPLOYMENT.md).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/beautijoo?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated origins (frontend URL in production)
CORS_ORIGINS=http://localhost:3001
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Storage ──────────────────────────────────────────────────
# local  = filesystem under STORAGE_LOCAL_PATH (dev, or prod WITH a persistent disk)
# s3     = S3-compatible object storage (recommended for Liara production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Public origin of the API (no /api/v1) — used for local-disk public URLs
# PUBLIC_API_URL=https://api.example.com

# S3 / Liara Object Storage (only when STORAGE_PROVIDER=s3|object|liara)
# S3_ENDPOINT=https://storage.iran.liara.space
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# Public base for objects (Liara: https://{bucket}.storage.iran.liara.space)
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
