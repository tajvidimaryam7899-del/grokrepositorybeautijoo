# Copy to .env for local development. Never commit .env.
# In production set these in the host secret store (Liara env / secrets).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/beautijoo?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated origins (frontend URL in production)
CORS_ORIGINS=http://localhost:3001
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Storage ──────────────────────────────────────────────────
# local  = filesystem under STORAGE_LOCAL_PATH (development, or prod WITH a Disk)
# s3     = S3-compatible object storage (recommended on Liara production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Public origin of the API (no /api/v1) — local-disk public image URLs only
# PUBLIC_API_URL=https://api.example.com

# S3 / Liara Object Storage (when STORAGE_PROVIDER=s3|object|liara)
# Values from Liara Object Storage console → تنظیمات / دسترسی با SDK
# Never put real keys in git.
#
# S3_ENDPOINT=https://storage.iran.liara.site
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
#
# REQUIRED: public base URL of the bucket (copy from Liara console; do not invent)
# S3_PUBLIC_URL=https://<bucket>.storage.iran.liara.site
#
# Liara requires path-style requests (default true). Set false only for pure AWS.
# S3_FORCE_PATH_STYLE=true
#
# Profile images (avatar/cover/logo): use a public-read bucket so <img src>
# works with stable URLs. Secrets stay on the server; only object keys are public.

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
