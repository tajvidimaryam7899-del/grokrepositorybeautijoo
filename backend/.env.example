# Copy to .env for local development. Never commit .env.
# In production set these in the host secret store (Liara env / secrets).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/beautijoo?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated origins (frontend URL in production)
CORS_ORIGINS=http://localhost:3001
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Storage ──────────────────────────────────────────────────
# local  = filesystem under STORAGE_LOCAL_PATH (development)
# s3     = S3-compatible object storage (recommended on Liara production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Liara Object Storage (STORAGE_PROVIDER=s3)
# Copy endpoint / keys from: Object Storage → bucket → تنظیمات → دسترسی با SDK
# S3_ENDPOINT=https://storage.iran.liara.site
# S3_REGION=default
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=beautijoo-media
#
# Public base URL: custom domain bound to the bucket in Liara (NOT *.storage.iran.liara.site).
# Recommended: connect media.beautijoo.com to bucket beautijoo-media, then:
# S3_PUBLIC_URL=https://media.beautijoo.com

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
