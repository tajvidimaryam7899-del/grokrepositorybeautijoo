# Copy to .env for local development. Never commit .env.
# Production: set secrets only in Liara app environment.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/beautijoo?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3001
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Storage ──────────────────────────────────────────────────
# local = disk (dev). s3 = Liara Object Storage (production).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Liara Object Storage — copy from: باکت → تنظیمات → دسترسی با SDK
# Do not invent values. Endpoint must match the console exactly.
#
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://storage.iran.liara.site
# S3_REGION=default
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=beautijoo-media
#
# Aliases also accepted: LIARA_ENDPOINT, LIARA_ACCESS_KEY, LIARA_SECRET_KEY, LIARA_BUCKET_NAME
#
# Public URL: bind a real domain to the bucket in Liara (DNS CNAME), then set:
# S3_PUBLIC_URL=https://media.beautijoo.com
# Liara default *.storage.iran.liara.site is panel-preview only — not for production delivery.

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
