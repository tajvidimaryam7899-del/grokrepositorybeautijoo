# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://beautijoo:beautijoo_dev@localhost:5432/beautijoo?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# SMS Provider (mock in development)
SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_API_URL=

# Payment Provider (mock in development)
PAYMENT_PROVIDER=mock
# PAYMENT_MERCHANT_ID=
# PAYMENT_CALLBACK_URL=

# File Storage (S3-compatible)
STORAGE_PROVIDER=local
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_REGION=

# App
APP_NAME=Beautijoo
APP_URL=http://localhost:3000
